<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Started once per observed tool event: keep start-up lean. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>false</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    A host, like the composition root of the tests: it joins the Claude evidence adapter (the hook protocol) with the Git
    implementation-state provider so the hook captures state with exactly the algorithm the controller uses.
  -->
  <ItemGroup>
    <ProjectReference Include="..\AgenticWorkflow.Application\AgenticWorkflow.Application.csproj" />
    <ProjectReference Include="..\AgenticWorkflow.Core\AgenticWorkflow.Core.csproj" />
    <ProjectReference Include="..\AgenticWorkflow.Execution.Local\AgenticWorkflow.Execution.Local.csproj" />
    <ProjectReference Include="..\AgenticWorkflow.Runtime.Herdr\AgenticWorkflow.Runtime.Herdr.csproj" />
  </ItemGroup>

</Project>
